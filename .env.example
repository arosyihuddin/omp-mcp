# Runtime
NODE_ENV=production
LOG_LEVEL=info

# MCP transport
# stdio | http | both
MCP_TRANSPORT=http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=48765
MCP_HTTP_PATH=/mcp

# Required for OMP Control/internal HTTP endpoints. `make setup` generates a random 256-bit token if empty.
# Configure the same value in the matching OMP Control instance. Keep it secret.
OMP_API_TOKEN=


# OAuth 2.0 for remote MCP clients. `make setup` prompts for username/password.
# Set MCP_PUBLIC_URL to the public HTTPS origin only, without /mcp or a trailing path.
MCP_PUBLIC_URL=
OMP_OAUTH_USERNAME=
OMP_OAUTH_PASSWORD=

# OMP
OMP_DEFAULT_CWD=/var/lib/omp-mcp/workspace

# Required to encrypt the per-instance sudo password saved from OMP Control.
# `make setup` generates a random 256-bit key if empty; keep it stable across restarts.
OMP_SUDO_ENCRYPTION_KEY=
