# Runtime
NODE_ENV=production
LOG_LEVEL=info

# MCP transport
# stdio | http | both
MCP_TRANSPORT=http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=48765
MCP_HTTP_PATH=/mcp

# Required for HTTP mode (`http` or `both`): shared Bearer token for all OMP-MCP HTTP endpoints.
# Configure the same value as the selected OMP Control instance credential.
OMP_API_TOKEN=

# OMP
OMP_DEFAULT_CWD=/var/lib/omp-mcp/workspace
