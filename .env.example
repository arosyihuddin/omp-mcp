# Runtime
NODE_ENV=production
LOG_LEVEL=info

# MCP transport
# stdio | http | both
MCP_TRANSPORT=http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=48765
MCP_HTTP_PATH=/mcp

# Required for OMP Control/internal HTTP endpoints. The MCP endpoint also accepts OAuth access tokens when OAuth is configured.
# Configure the same value as the selected OMP Control instance credential.
OMP_API_TOKEN=


# Optional OAuth 2.0 for remote MCP clients (leave empty to keep OAuth disabled).
# Set this to the public HTTPS origin only, without /mcp or a trailing path.
MCP_PUBLIC_URL=
OMP_OAUTH_USERNAME=
OMP_OAUTH_PASSWORD=

# OMP
OMP_DEFAULT_CWD=/var/lib/omp-mcp/workspace
